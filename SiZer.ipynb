      "Cluster 0 vs Cluster i:\n",
      " • vs 1:  z = 37.34,  p = 0.000e+00\n",
      " • vs 2:  z = 9.63,  p = 0.000e+00\n",
      " • vs 3:  z = 30.24,  p = 0.000e+00\n"
     ]
    }
   ],
   "source": [
    "import math\n",
    "from scipy.stats import norm\n",
    "\n",
    "# your summary statistics\n",
    "clusters = {\n",
    "    0: {'mean': 21490.0, 'ci_lower': 21300.0, 'ci_upper': 21700.0},\n",
    "    1: {'mean': 17230.0, 'ci_lower': 17100.0, 'ci_upper': 17300.0},\n",
    "    2: {'mean': 20100.0, 'ci_lower': 19900.0, 'ci_upper': 20300.0},\n",
    "    3: {'mean': 18040.0, 'ci_lower': 17900.0, 'ci_upper': 18100.0},\n",
    "}\n",
    "\n",
    "# 1. Approximate each cluster's standard error from its 95% CI:\n",
    "#    SE ≈ (upper – lower) / (2 * 1.96)\n",
    "for k, v in clusters.items():\n",
    "    v['se'] = (v['ci_upper'] - v['ci_lower']) / (2 * 1.96)\n",
    "\n",
    "# 2. Compare cluster 0 to clusters 1, 2, and 3\n",
    "se0 = clusters[0]['se']\n",
    "mean0 = clusters[0]['mean']\n",
    "\n",
    "print(\"Cluster 0 vs Cluster i:\")\n",
    "for i in [1, 2, 3]:\n",
    "    meani = clusters[i]['mean']\n",
    "    sei = clusters[i]['se']\n",
    "    diff = mean0 - meani\n",
    "    se_diff = math.sqrt(se0**2 + sei**2)\n",
    "    z_stat = diff / se_diff\n",
    "    p_val = 2 * (1 - norm.cdf(abs(z_stat)))\n",
    "    print(f\" • vs {i}:  z = {z_stat:.2f},  p = {p_val:.3e}\")\n"
   ]
  }
